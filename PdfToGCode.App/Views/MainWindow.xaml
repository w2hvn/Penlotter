<Window x:Class="PdfToGCode.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:rendering="clr-namespace:PdfToGCode.App.Rendering"
        mc:Ignorable="d"
        Title="PDF to G-Code Converter" Height="900" Width="1400"
        Background="{StaticResource BrushSecondary}"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Controls -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="Auto"/> <!-- Status -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BrushPrimary}" Height="60" Padding="20,0">
            <TextBlock Text="PDF to G-Code Studio"
                       Foreground="White" FontSize="24" FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Controls Panel -->
        <Border Grid.Row="1" Background="White" Padding="15" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Import, Range -->
                    <ColumnDefinition Width="Auto"/> <!-- Fonts -->
                    <ColumnDefinition Width="Auto"/> <!-- Settings -->
                    <ColumnDefinition Width="*"/>    <!-- Spacer -->
                    <ColumnDefinition Width="Auto"/> <!-- Actions -->
                </Grid.ColumnDefinitions>

                <!-- Left: Import, Range -->
                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,15,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Button Name="btnImport" Content="Import PDF" Click="btnImport_Click" Style="{StaticResource ModernButtonStyle}" Margin="0,0,10,0"/>
                        <Label Content="Range:" Style="{StaticResource LabelStyle}" Margin="0,0,5,0"/>
                        <TextBox Name="txtPageRange" Width="80" VerticalContentAlignment="Center" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Name="btnSetRange" Content="Set Range" Click="btnSetRange_Click" Style="{StaticResource ModernButtonStyle}" Width="100" HorizontalAlignment="Left"/>
                    </StackPanel>
                </StackPanel>

                <!-- Fonts -->
                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="15,0,15,0">
                    <Border BorderBrush="{StaticResource BrushLightBorder}" BorderThickness="1,0,0,0" Padding="15,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <Label Content="Title Font (Caps):" Style="{StaticResource LabelStyle}" Width="120"/>
                                <ComboBox Name="cboTitleFont" Width="150" VerticalContentAlignment="Center"
                                          SelectionChanged="cboTitleFont_SelectionChanged"
                                          Style="{StaticResource ModernComboBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Label Content="Body Font:" Style="{StaticResource LabelStyle}" Width="120"/>
                                <ComboBox Name="cboBodyFont" Width="150" VerticalContentAlignment="Center"
                                          SelectionChanged="cboBodyFont_SelectionChanged"
                                          Style="{StaticResource ModernComboBoxStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Settings -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="15,0,0,0">
                    <Border BorderBrush="{StaticResource BrushLightBorder}" BorderThickness="1,0,0,0" Padding="15,0,0,0"/>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Label Content="Feed Rate:" Style="{StaticResource LabelStyle}" Width="70"/>
                            <TextBox Name="txtFeedRate" Width="50" VerticalContentAlignment="Center" Margin="0,0,10,0" Style="{StaticResource ModernTextBoxStyle}"/>

                            <Label Content="Z Down:" Style="{StaticResource LabelStyle}" Width="60"/>
                            <TextBox Name="txtZDown" Width="50" VerticalContentAlignment="Center" Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Travel:" Style="{StaticResource LabelStyle}" Width="70"/>
                            <TextBox Name="txtTravelSpeed" Width="50" VerticalContentAlignment="Center" Margin="0,0,10,0" Style="{StaticResource ModernTextBoxStyle}"/>

                            <Label Content="Z Safe:" Style="{StaticResource LabelStyle}" Width="60"/>
                            <TextBox Name="txtZSafe" Width="50" VerticalContentAlignment="Center" Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>
                    </StackPanel>

                    <CheckBox Name="chkServo" Content="Servo Mode" VerticalAlignment="Center" Margin="15,0,0,0"
                              Style="{StaticResource ModernCheckBoxStyle}"/>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="btnVectorize" Content="Preview" Click="btnVectorize_Click" Style="{StaticResource ModernButtonStyle}" Margin="5,0"/>
                    <Button Name="btnGenerate" Content="Generate" Click="btnGenerate_Click" Style="{StaticResource ModernButtonStyle}" Margin="5,0"/>
                    <Button Name="btnSave" Content="Save" Click="btnSave_Click" Style="{StaticResource ModernButtonStyle}" Margin="5,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="2" Margin="15,0,15,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: PDF Preview -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="PDF View" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,10"/>
                    <Border Grid.Row="1" BorderBrush="{StaticResource BrushLightBorder}" BorderThickness="1" ClipToBounds="True">
                        <rendering:ZoomPanCanvas x:Name="canvasPdf" Background="#F5F5F5"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Right Panel: Vector Preview -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Vector Preview" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,10"/>
                    <Border Grid.Row="1" BorderBrush="{StaticResource BrushLightBorder}" BorderThickness="1" ClipToBounds="True">
                        <rendering:ZoomPanCanvas x:Name="canvasPreview" Background="White"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#333333" Padding="10,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Name="txtStatus" Text="Ready" Foreground="White" FontSize="12" Margin="0,0,15,0"/>
                <ProgressBar Name="progressBar" Width="200" Height="10" IsIndeterminate="True" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
