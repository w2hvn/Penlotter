<Window x:Class="PdfToGCode.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rendering="clr-namespace:PdfToGCode.App.Rendering"
        Title="PDF to G-Code" Height="800" Width="1200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBar Grid.Row="0">
            <Button Name="BtnOpenPdf" Content="Open PDF" Click="BtnOpenPdf_Click"/>
            <Separator/>
            <Button Name="BtnLoadFont" Content="Load Font" Click="BtnLoadFont_Click"/>
            <Separator/>
            <Button Name="BtnGenerateGCode" Content="Generate G-Code" Click="BtnGenerateGCode_Click"/>
        </ToolBar>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- PDF Preview (Image) -->
            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="5">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Image Name="PdfPreviewImage" Stretch="None"/>
                </ScrollViewer>
            </Border>

            <!-- Vector Preview -->
            <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Margin="5">
                <rendering:ZoomPanCanvas x:Name="VectorCanvas" Background="White"/>
            </Border>
        </Grid>
    </Grid>
</Window>
