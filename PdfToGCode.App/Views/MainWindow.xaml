<Window x:Class="PdfToGCode.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:rendering="clr-namespace:PdfToGCode.App.Rendering"
        mc:Ignorable="d"
        Title="PDF to G-Code Converter" Height="800" Width="1200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBar Grid.Row="0" Padding="5">
            <Button Name="btnImport" Content="Import PDF" Click="btnImport_Click" Margin="0,0,5,0" Padding="5,2"/>
            <Separator/>
            <Button Name="btnVectorize" Content="Single-line Font" Click="btnVectorize_Click" Margin="5,0,5,0" Padding="5,2"/>
            <Separator/>
            <Button Name="btnGenerate" Content="Generate G-code" Click="btnGenerate_Click" Margin="5,0,5,0" Padding="5,2"/>
            <Button Name="btnSave" Content="Save G-code" Click="btnSave_Click" Margin="5,0,0,0" Padding="5,2"/>
        </ToolBar>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: PDF Preview -->
            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="5">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Image Name="imgPdfPreview" Stretch="None"/>
                </ScrollViewer>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

            <!-- Right Panel: Vector Preview -->
            <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Margin="5" ClipToBounds="True">
                <!-- Using ZoomPanCanvas -->
                <rendering:ZoomPanCanvas x:Name="canvasPreview" Background="White"/>
            </Border>
        </Grid>
    </Grid>
</Window>
